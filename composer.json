            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "citieslookup",
        "city lookup api",
        "cities api",
        "city api",
        "city search api",
        "free cities api"
    ],
    "homepage": "https://apiverve.com/marketplace/citieslookup?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/citieslookup",
        "source": "https://github.com/apiverve/citieslookup-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
